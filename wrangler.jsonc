{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "microworld",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"],
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "microworld.kaf.sh", "custom_domain": true }],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "vars": {
    "MCP_ALLOWED_ORIGINS": "https://microworld.kaf.sh,http://localhost:4321,http://127.0.0.1:4321,http://localhost:8787,http://127.0.0.1:8787",
  },
  "observability": { "enabled": true },
}
