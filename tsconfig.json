{
  "compilerOptions": {
    "target": "ES2024",
    "types": ["node"],
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "test", "scripts", "api"]
}
