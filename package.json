{
  "name": "microworld",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && astro check --tsconfig tsconfig.astro.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "bench": "node scripts/bench.ts",
    "example": "node scripts/example.ts",
    "dev": "node scripts/dev.ts",
    "dev:site": "astro dev --host 127.0.0.1",
    "build": "pnpm demos && astro build",
    "demos": "node scripts/demos.ts",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "pnpm check && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@valibot/to-json-schema": "1.7.1",
    "astro": "7.2.9",
    "tailwindcss": "4.3.3",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
